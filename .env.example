# Copiați în .env și completați parola: cp .env.example .env
# .env nu intră în git. Valorile de aici sunt doar exemple.
POSTGRES_DB=p21
POSTGRES_USER=p21
POSTGRES_PASSWORD=change-me

# Opțional: hash-ul BCrypt al parolei utilizatorilor de test din seed (admin, operator,
# contabil). Gol = conturile există, dar nu se pot loga. Puneți doar hash-ul, niciodată parola,
# și între ghilimele simple (hash-ul conține $). Generare, cu parola aleasă de voi:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'parola-voastra' | tr -d ':\n'
P21_SEED_PASSWORD_HASH=
